/**
 * @description Access control for EnviroWise EIA.
 * Only signed-in @pucp.edu.pe or @pucp.pe accounts can read or write anything.
 * @dataStructure Groups live in `/groups/{groupId}` with `ownerId`, `ownerEmail` and `memberEmails`
 * (lowercase emails, owner included). Projects point at a group through `groupId`.
 * @keyDecision Only the group's creator (`ownerId`) can edit it, change its members or delete it.
 * Members, identified by their sign-in email, can read the group.
 * @keyDecision Projects and the rest of the data keep the existing open model for signed-in
 * PUCP accounts; the app filters projects by owner and group membership.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null && request.auth.token.email.matches('.*@pucp(\\.edu)?\\.pe$');
    }

    function myEmail() {
      return request.auth.token.email.lower();
    }

    function validGroup(data) {
      return data.name is string && data.name.size() > 0
        && data.memberEmails is list
        && data.ownerEmail in data.memberEmails;
    }

    match /groups/{groupId} {
      allow read: if isSignedIn()
        && (resource.data.ownerId == request.auth.uid || myEmail() in resource.data.memberEmails);

      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerEmail == myEmail()
        && validGroup(request.resource.data);

      // The creator can never be changed or removed from the members list.
      allow update: if isSignedIn()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.ownerEmail == resource.data.ownerEmail
        && validGroup(request.resource.data);

      allow delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;
    }

    // Everything except groups keeps the existing rule.
    match /{collection}/{document=**} {
      allow read, write: if isSignedIn() && collection != 'groups';
    }
  }
}
